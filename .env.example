# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah meng-commit file .env ke GitHub.

# Kunci rahasia sesi login (wajib di production). Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-yang-panjang

# Kosongkan untuk memakai SQLite lokal (instance/lyznart.db).
# Isi dengan URL PostgreSQL (mis. dari Neon) untuk database online yang persisten.
# Contoh: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# development | production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
